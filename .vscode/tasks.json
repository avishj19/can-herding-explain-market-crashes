{
  // Run these with Terminal > Run Task... (or Cmd-Shift-B for the default build task).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Quick check: S&P 500 vs model (main.py)",
      "type": "shell",
      "command": "python3 main.py",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Make all figures (about 2 min)",
      "type": "shell",
      "command": "python3 make_figures.py",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Tests: quick",
      "type": "shell",
      "command": "python3 -m pytest tests/ -q -m \"not slow\"",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Tests: all (slow)",
      "type": "shell",
      "command": "python3 -m pytest tests/ -q",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
